<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<BorderPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.github.joao.view.IngredienteController">
    <center>
        <TableView fx:id="tableIngredientes" prefHeight="200.0" prefWidth="374.0" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colIngrediente" prefWidth="75.0" text="Nome" />
                <TableColumn fx:id="colQuantidade" prefWidth="75.0" text="Quantidade" />
                <TableColumn fx:id="colUnidade" prefWidth="75.0" text="Unidade" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </center>
    <left>
        <GridPane prefHeight="400.0" prefWidth="250.0" vgap="10.0" BorderPane.alignment="CENTER">
            <children>
                <Label text="Inserir novo ingrediente" GridPane.halignment="CENTER" />
                <Label text="Nome" GridPane.rowIndex="1" />
                <TextField fx:id="txtNome" GridPane.rowIndex="2" />
                <Label text="Unidade" GridPane.halignment="LEFT" GridPane.rowIndex="3" />
                <Spinner fx:id="spinUnidade" prefWidth="120.0" GridPane.halignment="RIGHT" GridPane.rowIndex="3" />
                <Label text="Quantidade" GridPane.rowIndex="4" />
                <Spinner fx:id="spinQtd" prefWidth="210.0" GridPane.rowIndex="5" />
                <Button fx:id="btnAddIngrediente" mnemonicParsing="false" text="Adicionar novo Ingrediente" GridPane.halignment="CENTER" GridPane.rowIndex="6" />
            </children>
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="30.0" prefHeight="40.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="20.0" prefHeight="25.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="30.0" prefHeight="35.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="40.0" prefHeight="50.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="20.0" prefHeight="25.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="30.0" prefHeight="35.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="50.0" prefHeight="60.0" vgrow="SOMETIMES" />
            </rowConstraints>
        </GridPane>
    </left>
</BorderPane>
